  "query": "UPDATE tokistack.waitlist\n           SET status     = 'invited'::tokistack.waitlist_status,\n               token      = $1,\n               invited_at = NOW()\n           WHERE email = $2\n             AND status <> 'registered'::tokistack.waitlist_status\n           RETURNING\n               email,\n               status AS \"status: WaitlistStatus\",\n               language,\n               token,\n               invited_at,\n               created_at",
